# StreetMP OS Environment Variables

# ==========================================
# AUTHENTICATION (NEXTAUTH)
# ==========================================
# CRITICAL: On a VPS, NEXTAUTH_URL MUST be exactly your production domain.
# If this is missing or localhost, Google Auth WILL NOT redirect properly.
NEXTAUTH_URL="https://os.streetmp.com"
NEXTAUTH_SECRET="your-32-byte-long-secure-random-secret"

# ==========================================
# GOOGLE OAUTH
# ==========================================
# Ensure the "Authorized redirect URIs" in your Google Cloud Console
# exactly matches: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgres://postgres:postgres@localhost:5432/streetmp"

# ==========================================
# ROUTER SERVICE (NeMo CLAW / Engine)
# ==========================================
NEXT_PUBLIC_ROUTER_SERVICE_URL="http://localhost:4000"
TITAN_BRIDGE_KEY="your-bridge-key"
